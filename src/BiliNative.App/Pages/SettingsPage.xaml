<Page
    x:Class="BiliNative.App.Pages.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer>
        <StackPanel Padding="24" Spacing="16" MaxWidth="760">
            <TextBlock Text="设置" FontSize="28" FontWeight="SemiBold" />
            <TextBlock Text="下载、FFmpeg 与更新" Opacity="0.7" />
            <TextBlock Text="下载目录" FontWeight="SemiBold" />
            <TextBox x:Name="DownloadDirectoryBox" PlaceholderText="例如 C:\Users\你\Downloads" />
            <TextBlock Text="并发下载任务数（1–3）" FontWeight="SemiBold" />
            <TextBox x:Name="ConcurrencyBox" />
            <TextBlock Text="失败重试次数" FontWeight="SemiBold" />
            <TextBox x:Name="RetryBox" />
            <TextBlock Text="FFmpeg 路径（可选）" FontWeight="SemiBold" />
            <TextBox x:Name="FfmpegPathBox" PlaceholderText="留空则查找应用目录或系统 PATH" />
            <CheckBox x:Name="MergeCheckBox" Content="下载完成后自动合并音视频" />
            <CheckBox x:Name="DeleteTempCheckBox" Content="合并成功后删除临时轨道" />
            <CheckBox x:Name="AutoUpdateCheckBox" Content="启动时自动检查 NovaClip 更新" />
            <TextBlock Text="更新通道" FontWeight="SemiBold" />
            <ComboBox x:Name="UpdateChannelBox">
                <ComboBoxItem Content="Preview（测试版）" Tag="Preview" />
                <ComboBoxItem Content="Stable（稳定版）" Tag="Stable" />
            </ComboBox>
            <StackPanel Orientation="Horizontal" Spacing="8">
                <Button Content="保存设置" Click="SaveButton_Click" />
                <Button Content="检查更新" Click="CheckUpdateButton_Click" />
                <Button x:Name="InstallUpdateButton" Content="下载并覆盖更新" Click="InstallUpdateButton_Click" IsEnabled="False" />
            </StackPanel>
            <TextBlock x:Name="UpdateStatusText" TextWrapping="Wrap" Foreground="{ThemeResource SystemControlHighlightAccentBrush}" />
        </StackPanel>
    </ScrollViewer>
</Page>
