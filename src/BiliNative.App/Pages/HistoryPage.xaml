<Page
    x:Class="BiliNative.App.Pages.HistoryPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Padding="24" RowSpacing="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <StackPanel>
            <TextBlock Text="历史" FontSize="28" FontWeight="SemiBold" />
            <TextBlock Text="已完成和失败的下载记录" Opacity="0.7" />
        </StackPanel>
        <ListView Grid.Row="1" x:Name="HistoryList">
            <ListView.ItemTemplate>
                <DataTemplate>
                    <Border Padding="14" Margin="0,0,0,8" CornerRadius="10" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                        <StackPanel Spacing="4">
                            <TextBlock Text="{Binding Title}" FontSize="16" TextWrapping="Wrap" />
                            <TextBlock Text="{Binding OutputPath}" Opacity="0.7" TextWrapping="Wrap" />
                            <TextBlock Text="{Binding State}" Opacity="0.7" />
                        </StackPanel>
                    </Border>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
    </Grid>
</Page>
