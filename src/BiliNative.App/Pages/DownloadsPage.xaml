<Page
    x:Class="BiliNative.App.Pages.DownloadsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Padding="24" RowSpacing="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <StackPanel>
            <TextBlock Text="下载" FontSize="28" FontWeight="SemiBold" />
            <TextBlock Text="原生流式下载队列" Opacity="0.7" />
        </StackPanel>
        <ListView Grid.Row="1" x:Name="TaskList" SelectionMode="Single">
            <ListView.ItemTemplate>
                <DataTemplate>
                    <Border Padding="14" Margin="0,0,0,8" CornerRadius="10" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Spacing="4">
                                <TextBlock Text="{Binding Title}" FontSize="16" TextWrapping="Wrap" />
                                <TextBlock Text="{Binding OutputPath}" Opacity="0.65" TextWrapping="Wrap" />
                                <TextBlock Text="{Binding ErrorMessage}" Foreground="#D13438" TextWrapping="Wrap" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" HorizontalAlignment="Right" Spacing="4">
                                <TextBlock Text="{Binding State}" HorizontalAlignment="Right" />
                                <ProgressBar Width="140" Minimum="0" Maximum="1" Value="{Binding ProgressFraction}" />
                            </StackPanel>
                        </Grid>
                    </Border>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
        <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="8">
            <Button Content="暂停 / 继续 / 重试" Click="PauseResumeButton_Click" />
            <Button Content="取消任务" Click="CancelButton_Click" />
            <TextBlock x:Name="StatusText" VerticalAlignment="Center" Opacity="0.7" />
        </StackPanel>
    </Grid>
</Page>
