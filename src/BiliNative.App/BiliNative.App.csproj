<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFrameworks>net10.0-windows10.0.17763.0</TargetFrameworks>
    <RootNamespace>BiliNative.App</RootNamespace>
    <AssemblyName>NovaClip</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Platforms>x64</Platforms>
    <PlatformTarget>x64</PlatformTarget>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <WindowsPackageType>None</WindowsPackageType>
    <EnableMsixTooling>true</EnableMsixTooling>
    <UseWinUI>true</UseWinUI>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <PublishSingleFile>false</PublishSingleFile>
    <PublishReadyToRun>false</PublishReadyToRun>
    <AssemblyVersion>1.0.0.3</AssemblyVersion>
    <FileVersion>1.0.0.3</FileVersion>
    <InformationalVersion>1.0.0-beta.3</InformationalVersion>
    <ApplicationIcon>..\..\assets\icons\NovaClip.ico</ApplicationIcon>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\BiliNative.Core\BiliNative.Core.csproj" />
    <ProjectReference Include="..\BiliNative.Infrastructure\BiliNative.Infrastructure.csproj" />
    <ProjectReference Include="..\BiliNative.WebBridge\BiliNative.WebBridge.csproj" />
    <PackageReference Include="Microsoft.WindowsAppSDK" />
    <PackageReference Include="Microsoft.Web.WebView2" />
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" PrivateAssets="all" />
    <Content Include="..\..\assets\js\bilibili-bridge.js" Link="assets\js\bilibili-bridge.js" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\..\assets\icons\NovaClip.png" Link="assets\icons\NovaClip.png" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\..\assets\icons\NovaClip.ico" Link="assets\icons\NovaClip.ico" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
