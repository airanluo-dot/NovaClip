<Application
    x:Class="NovaClip.App.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:NovaClip.App">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
            </ResourceDictionary.MergedDictionaries>
            <x:Double x:Key="AppSpacing4">4</x:Double>
            <x:Double x:Key="AppSpacing8">8</x:Double>
            <x:Double x:Key="AppSpacing12">12</x:Double>
            <x:Double x:Key="AppSpacing16">16</x:Double>
            <x:Double x:Key="AppSpacing24">24</x:Double>
            <x:Double x:Key="AppSpacing32">32</x:Double>
            <x:Double x:Key="AppContentMaxWidth">920</x:Double>
            <x:Double x:Key="AppBrowserSidePaneWidth">340</x:Double>
        </ResourceDictionary>
    </Application.Resources>
</Application>
