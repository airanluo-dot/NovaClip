<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFrameworks>net10.0-windows10.0.17763.0</TargetFrameworks>
    <RootNamespace>NovaClip.App</RootNamespace>
    <AssemblyName>NovaClip</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Platforms>x64</Platforms>
    <PlatformTarget>x64</PlatformTarget>
    <RuntimeIdentifier>$(NovaClipRuntimeIdentifier)</RuntimeIdentifier>
    <WindowsPackageType>None</WindowsPackageType>
    <EnableMsixTooling>false</EnableMsixTooling>
    <UseWinUI>true</UseWinUI>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <PublishSingleFile>false</PublishSingleFile>
    <PublishReadyToRun>false</PublishReadyToRun>
    <AssemblyVersion>$(NovaClipAssemblyVersion)</AssemblyVersion>
    <FileVersion>$(NovaClipAssemblyVersion)</FileVersion>
    <InformationalVersion>$(NovaClipVersion)</InformationalVersion>
    <ApplicationIcon>....assetsiconsNovaClip.ico</ApplicationIcon>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..NovaClip.ContractsNovaClip.Contracts.csproj" />
    <ProjectReference Include="..NovaClip.CoreNovaClip.Core.csproj" />
    <ProjectReference Include="..NovaClip.InfrastructureNovaClip.Infrastructure.csproj" />
    <ProjectReference Include="..NovaClip.BilibiliNovaClip.Bilibili.csproj" />
    <ProjectReference Include="..NovaClip.WindowsNovaClip.Windows.csproj" />
    <PackageReference Include="Microsoft.WindowsAppSDK" />
    <PackageReference Include="Microsoft.Web.WebView2" />
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" PrivateAssets="all" />
    <Content Include="....assetsjsilibili-bridge.js" Link="assetsjsilibili-bridge.js" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="....assetsiconsNovaClip.png" Link="assetsiconsNovaClip.png" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="....assetsiconsNovaClip.ico" Link="assetsiconsNovaClip.ico" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
  <Target Name="CopyAppPriToPublish" AfterTargets="Publish">
    <Copy SourceFiles="$(TargetDir)$(TargetName).pri"
          DestinationFiles="$(PublishDir)resources.pri"
          OverwriteReadOnlyFiles="true"
          SkipUnchangedFiles="false"
          Condition="Exists('$(TargetDir)$(TargetName).pri')" />
  </Target>
</Project>
