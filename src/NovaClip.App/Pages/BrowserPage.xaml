<Page x:Class="NovaClip.App.Pages.BrowserPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:controls="using:Microsoft.UI.Xaml.Controls">
    <Grid Padding="16" RowSpacing="12">
        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
        <Grid ColumnSpacing="8">
            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
            <Button x:Name="BackButton" x:Uid="Browser_Back" Click="BackButton_Click"><SymbolIcon Symbol="Back" /></Button>
            <Button x:Name="ForwardButton" Grid.Column="1" x:Uid="Browser_Forward" Click="ForwardButton_Click"><SymbolIcon Symbol="Forward" /></Button>
            <Button x:Name="RefreshButton" Grid.Column="2" x:Uid="Browser_Refresh" Click="RefreshButton_Click"><SymbolIcon Symbol="Refresh" /></Button>
            <TextBox x:Name="AddressBox" Grid.Column="3" x:Uid="Browser_Address" KeyDown="AddressBox_KeyDown" />
            <Button Grid.Column="4" x:Uid="Browser_Home" Click="HomeButton_Click"><SymbolIcon Symbol="Home" /></Button>
        </Grid>
        <Grid x:Name="BrowserLayout" Grid.Row="1" ColumnSpacing="12" RowSpacing="12">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition x:Name="MediaColumn" Width="340" /></Grid.ColumnDefinitions>
            <Grid.RowDefinitions><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
            <Border BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="8">
                <controls:WebView2 x:Name="BrowserWebView" />
            </Border>
            <ScrollViewer x:Name="MediaPane" Grid.Column="1" VerticalScrollBarVisibility="Auto">
                <StackPanel Spacing="12">
                    <TextBlock x:Uid="Browser_CurrentMedia" Style="{ThemeResource TitleTextBlockStyle}" />
                    <ProgressRing x:Name="DetectionProgress" IsActive="False" HorizontalAlignment="Left" />
                    <TextBlock x:Name="DetectionText" x:Uid="Browser_NoMedia" TextWrapping="Wrap" />
                    <StackPanel x:Name="MediaDetails" Spacing="8" Visibility="Collapsed">
                        <TextBlock x:Name="TitleText" Style="{ThemeResource SubtitleTextBlockStyle}" TextWrapping="Wrap" />
                        <TextBlock x:Name="IdentityText" Opacity="0.7" TextWrapping="Wrap" />
                        <ComboBox x:Name="QualityCombo" x:Uid="Browser_Quality" HorizontalAlignment="Stretch" />
                        <TextBlock x:Name="TrackText" Opacity="0.7" TextWrapping="Wrap" />
                        <Button x:Name="AddDownloadButton" x:Uid="Browser_DownloadButton" Click="AddDownloadButton_Click" IsEnabled="False" />
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>
            <VisualStateManager.VisualStateGroups>
                <VisualStateGroup>
                    <VisualState x:Name="Wide" />
                    <VisualState x:Name="Narrow">
                        <VisualState.StateTriggers><AdaptiveTrigger MinWindowWidth="0" /></VisualState.StateTriggers>
                        <VisualState.Setters>
                            <Setter Target="MediaPane.(Grid.Column)" Value="0" />
                            <Setter Target="MediaPane.(Grid.Row)" Value="1" />
                            <Setter Target="MediaColumn.Width" Value="0" />
                        </VisualState.Setters>
                    </VisualState>
                    <VisualState x:Name="Desktop">
                        <VisualState.StateTriggers><AdaptiveTrigger MinWindowWidth="900" /></VisualState.StateTriggers>
                    </VisualState>
                </VisualStateGroup>
            </VisualStateManager.VisualStateGroups>
        </Grid>
        <InfoBar x:Name="BrowserInfoBar" Grid.Row="2" IsOpen="False" IsClosable="True">
            <InfoBar.ActionButton><Button x:Name="InfoActionButton" x:Uid="Browser_OpenExternal" Click="InfoActionButton_Click" Visibility="Collapsed" /></InfoBar.ActionButton>
        </InfoBar>
    </Grid>
</Page>
