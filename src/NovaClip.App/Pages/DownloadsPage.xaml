<Page x:Class="NovaClip.App.Pages.DownloadsPage" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Grid Padding="24" RowSpacing="16"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <TextBlock x:Uid="Downloads_Title" Style="{ThemeResource TitleTextBlockStyle}" />
    <Grid Grid.Row="1"><TextBlock x:Uid="Downloads_Empty" HorizontalAlignment="Center" VerticalAlignment="Center" Opacity="0.7" />
      <ListView x:Name="TaskList" SelectionMode="Single"><ListView.ItemTemplate><DataTemplate><Grid Padding="8" ColumnSpacing="12"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel Spacing="4"><TextBlock Text="{Binding Title}" FontWeight="SemiBold"/><TextBlock Text="{Binding StateText}" Opacity="0.7"/><ProgressBar Value="{Binding ProgressFraction}" Maximum="1"/></StackPanel><CommandBar Grid.Column="1" DefaultLabelPosition="Right"><AppBarButton x:Uid="Downloads_PauseResume" Click="PauseResumeButton_Click" Icon="Pause"/><AppBarButton x:Uid="Downloads_Cancel" Click="CancelButton_Click" Icon="Cancel"/></CommandBar></Grid></DataTemplate></ListView.ItemTemplate></ListView>
    </Grid><InfoBar x:Name="StatusBar" Grid.Row="2" IsOpen="False" IsClosable="True"/><TextBlock x:Name="StatusText" Grid.Row="2" Visibility="Collapsed"/>
  </Grid>
</Page>
