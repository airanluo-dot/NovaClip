<Page x:Class="NovaClip.App.Pages.HistoryPage" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Padding="28,24" RowSpacing="20">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
        <TextBlock x:Uid="History_Title" Style="{StaticResource PageHeadingStyle}"/>
        <Grid Grid.Row="1">
            <StackPanel x:Name="EmptyState" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="16" IsHitTestVisible="False">
                <Border Background="{ThemeResource SubtleFillColorSecondaryBrush}" CornerRadius="24" Width="80" Height="80" HorizontalAlignment="Center"><FontIcon Glyph="&#xE81C;" FontSize="32" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/></Border>
                <TextBlock x:Uid="History_Empty" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" TextAlignment="Center" MaxWidth="320"/>
            </StackPanel>
            <ListView x:Name="HistoryList" Background="Transparent" ItemContainerStyle="{StaticResource DownloadListItemStyle}">
                <ListView.ItemTemplate><DataTemplate>
                    <Border Style="{StaticResource SurfaceCardStyle}">
                        <Grid ColumnSpacing="16"><Grid.ColumnDefinitions><ColumnDefinition Width="40"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <FontIcon Glyph="&#xE8A5;" FontSize="22" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                            <StackPanel Grid.Column="1" Spacing="6"><TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="15" TextTrimming="CharacterEllipsis"/><TextBlock Text="{Binding OutputPath}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="12" TextTrimming="CharacterEllipsis" ToolTipService.ToolTip="{Binding OutputPath}"/></StackPanel>
                        </Grid>
                    </Border>
                </DataTemplate></ListView.ItemTemplate>
            </ListView>
        </Grid>
    </Grid>
</Page>
