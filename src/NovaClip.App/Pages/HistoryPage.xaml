<Page x:Class="NovaClip.App.Pages.HistoryPage" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Grid Padding="24" RowSpacing="16"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><TextBlock x:Uid="History_Title" Style="{ThemeResource TitleTextBlockStyle}"/><Grid Grid.Row="1"><TextBlock x:Uid="History_Empty" HorizontalAlignment="Center" VerticalAlignment="Center" Opacity="0.7"/><ListView x:Name="HistoryList"><ListView.ItemTemplate><DataTemplate><StackPanel Padding="8" Spacing="4"><TextBlock Text="{Binding Title}" FontWeight="SemiBold"/><TextBlock Text="{Binding OutputPath}" Opacity="0.7" TextTrimming="CharacterEllipsis"/></StackPanel></DataTemplate></ListView.ItemTemplate></ListView></Grid></Grid>
</Page>
