<Page x:Class="NovaClip.App.Pages.SettingsPage" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <ScrollViewer><StackPanel Padding="24" Spacing="16" MaxWidth="920" HorizontalAlignment="Stretch">
    <TextBlock x:Uid="Settings_Title" Style="{ThemeResource TitleTextBlockStyle}"/>
    <Expander x:Uid="Settings_General" IsExpanded="True"><StackPanel Spacing="12" Padding="0,12"><ComboBox x:Name="ThemeBox" x:Uid="Settings_Theme" SelectionChanged="ImmediateSetting_Changed"><ComboBoxItem x:Uid="Option_System" Tag="System"/><ComboBoxItem x:Uid="Option_Light" Tag="Light"/><ComboBoxItem x:Uid="Option_Dark" Tag="Dark"/></ComboBox></StackPanel></Expander>
    <Expander x:Uid="Settings_Download" IsExpanded="True"><StackPanel Spacing="12" Padding="0,12"><TextBlock x:Uid="Settings_DirectoryLabel" FontWeight="SemiBold"/><TextBlock x:Name="DownloadDirectoryText" TextWrapping="Wrap" IsTextSelectionEnabled="True"/><StackPanel Orientation="Horizontal" Spacing="8"><Button x:Uid="Settings_SelectFolder" Click="SelectFolder_Click"/><Button x:Uid="Settings_OpenFolder" Click="OpenFolder_Click"/></StackPanel><RadioButtons x:Name="ConcurrencyButtons" x:Uid="Settings_Concurrency" SelectionChanged="ImmediateSetting_Changed"><RadioButton x:Uid="Settings_Concurrency1" Tag="1"/><RadioButton x:Uid="Settings_Concurrency2" Tag="2"/><RadioButton x:Uid="Settings_Concurrency3" Tag="3"/></RadioButtons><ComboBox x:Name="QualityBox" x:Uid="Settings_DefaultQuality" SelectionChanged="ImmediateSetting_Changed"><ComboBoxItem x:Uid="Option_Highest" Tag="Highest"/><ComboBoxItem x:Uid="Option_Player" Tag="Player"/><ComboBoxItem x:Uid="Option_1080P" Tag="1080P"/><ComboBoxItem x:Uid="Option_720P" Tag="720P"/></ComboBox><ComboBox x:Name="CodecBox" x:Uid="Settings_DefaultCodec" SelectionChanged="ImmediateSetting_Changed"><ComboBoxItem x:Uid="Option_Auto" Tag="Auto"/><ComboBoxItem x:Uid="Option_AVC" Tag="AVC"/><ComboBoxItem x:Uid="Option_HEVC" Tag="HEVC"/><ComboBoxItem x:Uid="Option_AV1" Tag="AV1"/></ComboBox><ComboBox x:Name="RetryBox" x:Uid="Settings_Retry" SelectionChanged="ImmediateSetting_Changed"><ComboBoxItem x:Uid="Option_Standard" Tag="Standard"/><ComboBoxItem x:Uid="Option_Aggressive" Tag="Aggressive"/><ComboBoxItem x:Uid="Option_NoRetry" Tag="Off"/></ComboBox></StackPanel></Expander>
    <Expander x:Uid="Settings_Browser"><StackPanel Spacing="12" Padding="0,12"><ComboBox x:Name="StartupBox" x:Uid="Settings_Startup" SelectionChanged="ImmediateSetting_Changed"><ComboBoxItem x:Uid="Option_Home" Tag="Home"/><ComboBoxItem x:Uid="Option_LastPage" Tag="LastPage"/></ComboBox><ComboBox x:Name="ExternalLinksBox" x:Uid="Settings_ExternalLinks" SelectionChanged="ImmediateSetting_Changed"><ComboBoxItem x:Uid="Option_SystemBrowser" Tag="System"/><ComboBoxItem x:Uid="Option_Ask" Tag="Ask"/></ComboBox><Button x:Uid="Settings_ClearLogin" Click="ClearLogin_Click"/></StackPanel></Expander>
    <Expander x:Uid="Settings_Merge"><StackPanel Spacing="12" Padding="0,12"><ToggleSwitch x:Name="MergeToggle" x:Uid="Settings_AutoMerge" Toggled="ImmediateSetting_Changed"/><ToggleSwitch x:Name="DeleteTempToggle" x:Uid="Settings_DeleteTemp" Toggled="ImmediateSetting_Changed"/><TextBlock x:Uid="Settings_FfmpegStatus" FontWeight="SemiBold"/><TextBlock x:Name="FfmpegPathText" TextWrapping="Wrap"/><StackPanel Orientation="Horizontal" Spacing="8"><Button x:Uid="Settings_FfmpegAuto" Click="DetectFfmpeg_Click"/><Button x:Uid="Settings_FfmpegChoose" Click="ChooseFfmpeg_Click"/><Button x:Uid="Settings_FfmpegTest" Click="TestFfmpeg_Click"/></StackPanel></StackPanel></Expander>
    <Expander x:Uid="Settings_Update"><StackPanel Spacing="12" Padding="0,12"><ToggleSwitch x:Name="AutoUpdateToggle" x:Uid="Settings_AutoUpdate" Toggled="ImmediateSetting_Changed"/><RadioButtons x:Name="ChannelButtons" x:Uid="Settings_Channel" SelectionChanged="ImmediateSetting_Changed"><RadioButton x:Uid="Settings_Stable" Tag="Stable"/><RadioButton x:Uid="Settings_Preview" Tag="Preview"/></RadioButtons><Button x:Uid="Settings_CheckUpdate" Click="CheckUpdate_Click" HorizontalAlignment="Left"/></StackPanel></Expander>
    <Expander x:Uid="Settings_Advanced"><StackPanel Spacing="12" Padding="0,12"><ToggleSwitch x:Name="DebugToggle" x:Uid="Settings_Debug" Toggled="ImmediateSetting_Changed"/><Button x:Uid="Settings_OpenLogs" Click="OpenLogs_Click" HorizontalAlignment="Left"/><Button x:Uid="Settings_ResetDetector" Click="ResetDetector_Click" HorizontalAlignment="Left"/></StackPanel></Expander>
    <Expander x:Uid="Settings_About"><StackPanel Padding="0,12"><TextBlock x:Uid="Settings_Version"/></StackPanel></Expander>
    <InfoBar x:Name="SettingsInfoBar" IsOpen="False" IsClosable="True"/>
  </StackPanel></ScrollViewer>
</Page>
