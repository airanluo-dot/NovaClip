<Window
    x:Class="NovaClip.App.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="48" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Grid x:Name="AppTitleBar" Grid.Row="0" Padding="16,0" ColumnSpacing="10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="24" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Image Source="assets/icons/NovaClip.png" Width="20" Height="20" AutomationProperties.Name="NovaClip" />
            <TextBlock Grid.Column="1" x:Uid="App_Name" VerticalAlignment="Center" FontWeight="SemiBold" />
            <TextBlock Grid.Column="2" x:Name="PageTitle" VerticalAlignment="Center" Opacity="0.7" />
        </Grid>
        <NavigationView x:Name="RootNavigationView" Grid.Row="1" IsSettingsVisible="True" IsBackEnabled="False" PaneDisplayMode="Auto" SelectionChanged="RootNavigationView_SelectionChanged">
            <NavigationView.MenuItems>
                <NavigationViewItem x:Uid="Navigation_Browser" Tag="browser"><NavigationViewItem.Icon><SymbolIcon Symbol="World" /></NavigationViewItem.Icon></NavigationViewItem>
                <NavigationViewItem x:Uid="Navigation_Downloads" Tag="downloads"><NavigationViewItem.Icon><SymbolIcon Symbol="Download" /></NavigationViewItem.Icon></NavigationViewItem>
                <NavigationViewItem x:Uid="Navigation_History" Tag="history"><NavigationViewItem.Icon><SymbolIcon Symbol="Clock" /></NavigationViewItem.Icon></NavigationViewItem>
            </NavigationView.MenuItems>
            <Frame x:Name="ContentFrame" />
        </NavigationView>
    </Grid>
</Window>
